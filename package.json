{
  "name": "nycm-friendfinder",
  "version": "1.0.0",
  "private": true,
  "description": "Find your friends at the NYC Marathon start",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply nycm-friendfinder --local",
    "db:migrate:remote": "wrangler d1 migrations apply nycm-friendfinder --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:q": "wrangler d1 execute nycm-friendfinder --local --command",
    "db:q:remote": "wrangler d1 execute nycm-friendfinder --remote --command",
    "db:snapshot": "wrangler d1 export nycm-friendfinder --remote --output=snapshots/nycm2026-final.sql",
    "typecheck": "tsc --noEmit",
    "roster:build": "node scripts/load_roster.mjs",
    "db:load:local": "wrangler d1 execute nycm-friendfinder --local --file=seed/roster_load.sql",
    "db:check:remote": "wrangler d1 execute nycm-friendfinder --remote --command \"SELECT (SELECT COUNT(*) FROM dim_color) colors, (SELECT COUNT(*) FROM dim_wave) waves, (SELECT COUNT(*) FROM dim_transport) transports, (SELECT COUNT(*) FROM dim_runner) runners, (SELECT COUNT(*) FROM fct_runner_start) assignments\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.20.0"
  }
}
